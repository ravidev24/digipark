# Server
PORT=5001

# Local MongoDB
MONGO_URI=mongodb://localhost:27017/parkingDB

# Atlas example (after you create cluster):
# MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/digipark?retryWrites=true&w=majority

JWT_SECRET=change_this_to_a_long_random_secret

# Frontend URL(s) for CORS — comma-separated for multiple
CLIENT_URL=http://localhost:3000

# Production example:
# CLIENT_URL=https://digipark.vercel.app

# Optional: first admin user (run: npm run seed:admin)
ADMIN_EMAIL=admin@parksmart.com
ADMIN_PASSWORD=admin123
